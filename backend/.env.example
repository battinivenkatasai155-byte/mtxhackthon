NODE_ENV=development
LOG_LEVEL=info
PORT=4000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
CLASSIFICATION_PROVIDER_URL=
CLASSIFICATION_PROVIDER_API_KEY=
CLUSTER_SIMILARITY_THRESHOLD=0.42
HIGH_PRIORITY_THRESHOLD=55
CRITICAL_PRIORITY_THRESHOLD=80
GRIEVANCE_DUE_HOURS=72
ESCALATION_INTERVAL_MS=900000

# Configure either DATABASE_URL or all of PGHOST, PGPORT, PGUSER, and PGDATABASE.
# Leave database settings unset to run liveness checks without database readiness.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PG_POOL_MAX=10
